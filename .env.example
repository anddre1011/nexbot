# ═══════════════════════════════════════════════════════════════════
# NexBot — Variables de entorno completas
# Copia este archivo a .env y rellena los valores
# ═══════════════════════════════════════════════════════════════════

# ─── SUPABASE ─────────────────────────────────────────────────────
# Supabase → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase → Settings → API → anon / public key (frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase → Settings → API → service_role key (backend, NUNCA expongas esto)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── OPENAI ───────────────────────────────────────────────────────
# platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-...

# ─── META / WHATSAPP CLOUD API ────────────────────────────────────
# Meta for Developers → WhatsApp → Access Token
META_TOKEN=EAAxxxxxxxxxxxxx

# Meta for Developers → WhatsApp → Phone Number ID
META_PHONE_NUMBER_ID=1234567890

# Token secreto que defines tú para verificar el webhook en Meta
META_WEBHOOK_VERIFY_TOKEN=mi-token-secreto-aleatorio

# ─── META ADS MARKETING API ───────────────────────────────────────
# Meta for Developers → Marketing API → Access Token (con permisos ads_read + ads_management)
META_ADS_TOKEN=EAAxxxxxxxxxxxxx

# business.facebook.com → Configuración → Cuentas publicitarias → ID (solo números)
META_ADS_ACCOUNT_ID=1234567890

# ─── TENANT ───────────────────────────────────────────────────────
# UUID del tenant en Supabase → tabla tenants → columna id
# Obtener después de registrarte y crear el tenant en la app
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─── FRONTEND ─────────────────────────────────────────────────────
# URL del backend (en producción, la URL pública de Coolify)
NEXT_PUBLIC_API_URL=https://api.tunexbot.com

# ─── BACKEND ──────────────────────────────────────────────────────
PORT=3001

# ─── AI AGENT ─────────────────────────────────────────────────────
AI_AGENT_PORT=3002

# ─── INACTIVIDAD (milisegundos) ───────────────────────────────────
# Tiempo sin respuesta antes de enviar mensaje de seguimiento (default: 1 hora)
FOLLOWUP_DELAY_MS=3600000

# Tiempo sin respuesta antes de cerrar conversación (default: 24 horas)
CLOSE_DELAY_MS=86400000
