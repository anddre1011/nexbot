PORT=3001

# Supabase — usar SERVICE key (no anon) para operaciones server-side
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# Meta / WhatsApp Cloud API
META_TOKEN=your-meta-access-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token

# Tenant activo en esta instancia (buscar ID en Supabase → tabla tenants)
TENANT_ID=your-tenant-uuid

# Inactividad
FOLLOWUP_DELAY_MS=3600000
CLOSE_DELAY_MS=86400000
